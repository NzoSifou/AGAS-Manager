  "_comment_landing": "Pages ouvertes DANS le jeu quand on clique sur la pub (fiche Play Store intégrée, navigateur interne). Ce ne sont pas des pubs à fermer : si elles apparaissent juste après un clic d'AGAS, c'est un détournement.",
  "landingPageActivityPatterns": [
    "LandingPage",
    "InternalBrowser",
    "StoreWebpage",
    "InlineStore",
    "OpenUrlActivity",
    "WebsiteActivity"
  ],

  "_comment_traps": "Pièges connus « Activity|id » : boutons de fermeture qui ouvrent la boutique si on clique trop tôt. Ignorés pendant les 30 premières secondes de la pub.",
  "knownEarlyTraps": [
    "com.fyber.inneractive.sdk.activities.InneractiveFullscreenAdActivity|skip_img"
  ],

  "_comment_playable": "Identifiants (id HTML ou de vue) qui signalent un mini-jeu. Seuls les mini-jeux reçoivent l'appui de réveil : sur une vidéo, un appui ouvrirait la boutique.",
  "playableMarkerIdPatterns": [
    "canvas",
    "cocos",
    "playable",
    "gamediv",
    "phaser",
    "pixi",
    "unity-?container"
  ],

  "_comment_video": "Identifiants d'une vidéo de pub. Tant qu'une vidéo occupe l'écran, pas d'appui de réveil : un appui sur la vidéo fait surgir une popup « Installer » (et retarde le bouton Next).",
  "videoMarkerIdPatterns": [
    "video"
  ],

  "_comment_store_exit": "Boutons « boutique » qui sont la SEULE sortie de certains mini-jeux (AppLovin : « Google Play » à la place de « Next » ; Food Hunt : « Ouvrir la boutique »). Utilisés en dernier recours ; la popup du Play Store qui s'ouvre est ensuite refermée. Libellé entier.",
  "storeExitTextPatterns": [
    "google play",
    "ouvrir la boutique",
    "open (the )?store",
    "visit (the )?store",
    "go to (the )?store",
    "voir (dans )?la boutique"
  ],

  "_comment_close": "Motifs (regex, insensibles à la casse). *Id* : cherché dans le nom d'identifiant de la vue (partie après ':id/'). *Text* : doit correspondre au texte ou à la description ENTIERS.",
