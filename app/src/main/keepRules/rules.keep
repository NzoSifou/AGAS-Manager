# AGAS Agent est chargé à la volée et compilé contre ces classes, par leur nom : si R8 est activé
# un jour, elles doivent rester intactes.

# Contrat Manager ↔ Agent.
-keep class fr.nzosifou.agas.agent.api.** { *; }

# Bibliothèque Kotlin : l'Agent ne l'embarque pas, il utilise celle du Manager.
-keep class kotlin.** { *; }
